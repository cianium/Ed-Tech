{
  "name": "hitech-learn",
  "version": "0.0.1-m0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --project tsconfig.core.json",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "verify:static": "node scripts/check-boundaries.mjs && node scripts/scan-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
